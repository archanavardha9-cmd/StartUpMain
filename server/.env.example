# Copy to server/.env and replace every placeholder before running in production.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/startup_cafe
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com

# Public client and admin origins allowed to access the API.
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Gmail SMTP credentials. Use a Google app password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=
